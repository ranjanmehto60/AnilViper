# Viper Gears environment variables
# Copy this file to .env.local and fill in your values.

# --- Twilio (SMS OTP delivery) ---
# Without these, OTP codes are logged to the server console (dev mode) and
# returned in API responses as `devOtp` so the login flow still works locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Razorpay (payments) ---
# Reserved for the live gateway integration. The storefront currently runs in
# test mode with a simulated payment flow.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
