# Viper Gears environment variables
# Copy this file to .env.local and fill in your values.

# --- Postgres (production database — required on Vercel, e.g. Vercel Postgres / Neon) ---
# The app no longer uses SQLite; all data (orders, inventory, products, sessions, OTPs)
# lives in Postgres. Create a free database and paste its pooled connection string here.
POSTGRES_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Twilio (SMS OTP delivery) ---
# Without these, OTP codes are logged to the server console (dev mode) and
# returned in API responses as `devOtp` so the login flow still works locally.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- Razorpay (Online Payments) ---
# Live keys: use the Razorpay Dashboard. Webhook secret must match the secret
# configured on the webhook URL {APP_URL}/api/webhooks/razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (Logistics & Shipping) ---
# Live panel credentials (login to apiv2.shiprocket.in). Set SHIPROCKET_PICKUP_LOCATION
# to the pickup location slug created in the Shiprocket panel (default: PRIMARY).
# Without these, orders fall back to simulated AWB numbers for local dev only.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=PRIMARY
